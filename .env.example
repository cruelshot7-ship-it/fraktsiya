# Copy to .env.local / Vercel / Railway. Never commit real secrets.

# Neon Postgres connection string (pooled). Without it the app uses in-memory PGLite.
DATABASE_URL=

# Telegram bot token from @BotFather — server only
BOT_TOKEN=

# Main trainer Telegram numeric id (role=trainer)
TRAINER_TG_ID=

# Optional: Better Auth / Sign-in with Grok (preview)
# BETTER_AUTH_SECRET=
# GROK_PROJECT_ID=
