# Copy to Vercel project "ruksha" → Settings → Environment Variables.
# Never commit real secrets.

# Neon Postgres (pooled). Required in production.
DATABASE_URL=

# Optional unpooled Neon URL (fallback if pooled missing)
# DATABASE_URL_UNPOOLED=

# Emergency only: allow in-memory PGLite in production (never for real users)
# ALLOW_PGLITE=1

# Telegram bot token from @BotFather — server only
BOT_TOKEN=

# Main trainer Telegram numeric id (role=trainer)
TRAINER_TG_ID=

# Brand WebGL hero on offer landing (0/false/off to disable)
# VITE_SHADER_BG=1

# After deploy with BOT_TOKEN set, open once:
#   https://ruksha.vercel.app/api/telegram
# This calls setWebhook → https://ruksha.vercel.app/api/telegram
